# Copy to .env and fill in. Never commit the real .env file.

# --- LLM providers ---
# Required if llm.primary_provider or llm.fallback_provider is "openai" in config/settings.yaml
OPENAI_API_KEY=

# Local LLaMA (Ollama, OpenAI-compatible endpoint). Defaults match a stock local Ollama install.
LOCAL_LLAMA_BASE_URL=http://localhost:11434/v1
LOCAL_LLAMA_MODEL=llama3.1
LOCAL_LLAMA_API_KEY=ollama

# --- Paths (override the defaults in config/settings.yaml if needed) ---
DQ_DATA_ROOT=./data
DQ_ARTIFACTS_ROOT=./artifacts
DQ_MODULES_ROOT=./modules

# --- Backend ---
DQ_API_HOST=127.0.0.1
DQ_API_PORT=8000
